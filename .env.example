# 클라우드 LLM 제공자 키 (사용하는 것만 채우면 됩니다)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=        # 이 책의 Gemini 실측 경로 (openrouter/google/gemini-3.8-flash)

# LiteLLM Proxy 마스터 키 — 비워 두면 Proxy가 시작되지 않는다 (1.106 기준)
# 생성: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# 7장부터 사용: 가상 키·예산 관리용 PostgreSQL
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# 5장부터 사용: 로컬 추론 서버 주소
OLLAMA_API_BASE=http://localhost:11434
VLLM_API_BASE=http://localhost:8000/v1
